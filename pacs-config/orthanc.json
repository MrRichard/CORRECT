{
  "Name": "CORRECT-PACS",
  "DicomAet": "ORTHANC",
  "DicomPort": 11114,
  "HttpPort": 8042,

  "AuthenticationEnabled": true,
  "SslEnabled" : false,
  "RemoteAccessAllowed" : true,
  "RegisteredUsers": {
    "raduser": "CHANGE_ME"
  },

  "Plugins": [
    "/usr/local/share/orthanc/plugins"
  ],

  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "Ssl": false
  },

  "OHIF": {
    "DataSource": "dicom-web"
  },

  "Verbose": false,

  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db"
}