#!/bin/sh
# Graphical CORRECT configuration editor (needs a desktop session or ssh -X).
# Edits /etc/correct/config.yaml; run with sudo to save and to restart the service.
# -I: with -m, Python would otherwise put the caller's cwd first on sys.path, so
# `sudo correct-config` run from a directory holding a planted module would run it as root.
# correct.pth in the bundled site-packages still puts /opt/correct/app on the path.
exec /opt/correct/runtime/bin/python3 -I -m correct_admin.config_ui "$@"
